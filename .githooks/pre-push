#!/bin/sh
# Refuses a push unless every pushed commit's tree and history pass the public release gate.
# Run: git, on push (enable in a clone with `git config core.hooksPath .githooks`); git passes one line per ref on stdin.
# When: every push; export the private term list locally first.
# Env: HARNESS_DENYLIST (required); PATH needs node, git and gitleaks.
# Writes: a temporary detached worktree per pushed commit that is not HEAD, removed after; temporary scan folders removed by the gate.
# Exit: 0 gate green, nonzero refuses the push.
# Used by: git core.hooksPath; seed enables it in the new repo.
# Uses: .release/check.mjs.
# Stop if locating the repo fails, so an incomplete scan never approves a push.
set -eu
# Git invokes hooks at the repo root; make the location explicit for direct invocations too.
cd "$(git rev-parse --show-toplevel)"
root=$(pwd)
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
head=$(git rev-parse HEAD)
tmp=""
cleanup() {
  [ -z "$tmp" ] || { git worktree remove --force "$tmp/w" 2>/dev/null || true; rm -rf "$tmp"; git worktree prune; }
  tmp=""
}
trap cleanup EXIT
seen=0
# Gate what is pushed, not what is checked out: `git push origin <sha>:refs/heads/x` sends a commit HEAD never held.
# No flags may opt a local push out of private terms.
while read -r _ref sha _remote_ref _remote_sha; do
  case "$sha" in *[!0]*) ;; *) continue ;; esac # an all-zero sha deletes a ref: nothing is sent
  seen=1
  commit=$(git rev-parse "$sha^{commit}")
  if [ "$commit" = "$head" ]; then
    node .release/check.mjs
  else
    # This checkout's gate reads the pushed commit's tree and history; the commit cannot swap in a weaker gate.
    tmp=$(mktemp -d)
    git -c core.hooksPath=/dev/null worktree add -q --detach "$tmp/w" "$commit"
    (cd "$tmp/w" && node "$root/.release/check.mjs")
    cleanup
  fi
done
# Run by hand with no ref lines: gate HEAD.
[ "$seen" = 1 ] || node .release/check.mjs
